{
  "name": "civitai-collection-downloader",
  "version": "1.0.0",
  "description": "批量下载 Civitai 收藏集/模型列表中的全部文件，支持断点续传与 SHA256 校验",
  "main": "cli.js",
  "bin": {
    "civitai-dl": "cli.js"
  },
  "scripts": {
    "login": "node cli.js login",
