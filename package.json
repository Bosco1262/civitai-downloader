    "download": "node cli.js download"
  },
  "keywords": [
    "civitai",
    "collection",
    "downloader",
    "lora"
  ],
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "devalue": "^6.0.3",
    "puppeteer-core": "^25.14.0"
  }
}
