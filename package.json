{
  "name": "civitai-downloader",
  "version": "1.0.0",
  "description": "批量下载 Civitai 收藏集/模型列表中的全部文件，支持断点续传与 SHA256 校验",
  "main": "cli.js",
  "bin": {
    "civitai-dl": "cli.js"
  },
  "scripts": {
    "ui": "node ui.js",
    "web": "node web.js",
    "login": "node cli.js login",
    "list": "node cli.js list",
    "download": "node cli.js download",
    "check": "node cli.js check",
    "verify": "node cli.js verify",
    "doctor": "node cli.js doctor",
    "pin": "node cli.js pin",
    "models": "node cli.js models",
    "test": "node --test tests/",
    "test:seq": "node scripts/run-tests.js"
  },
  "keywords": [
    "civitai",
    "collection",
    "downloader",
    "lora"
  ],
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "devalue": "^6.0.3",
    "prompts": "^2.4.2",
    "puppeteer-core": "^25.14.0"
  }
}
